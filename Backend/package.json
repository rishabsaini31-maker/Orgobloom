{
  "_moduleAliases": {
    "@": "dist",
    "@/types": "dist/types",
    "@/utils": "dist/utils",
    "@/middleware": "dist/middleware",
    "@/routes": "dist/routes",
    "@/services": "dist/services",
    "@/db": "dist/db",
    "@/templates": "dist/templates"
  },
  "type": "module",
  "name": "orgobloom-backend",
  "version": "2.0.0",
  "description": "Orgobloom Backend - Express API with Drizzle ORM",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node patch-paths.cjs && node dist/server.js",
    "migrate:startup": "tsx src/scripts/runStartupMigrations.ts",
    "setup": "tsx src/setup.ts",
    "update-admin": "tsx src/update-admin.ts",
    "db:generate": "drizzle-kit generate:pg",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push:pg",
    "db:studio": "drizzle-kit studio",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [
    "express",
    "typescript",
    "drizzle",
    "supabase",
    "ecommerce"
  ],
  "author": "",
  "license": "ISC",
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@eslint/eslintrc": "^3.3.3",
    "@paralleldrive/cuid2": "^3.3.0",
    "@supabase/supabase-js": "^2.39.7",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.11.5",
    "@types/nodemailer": "^6.4.22",
    "@types/pdfkit": "^0.13.3",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.5",
    "csrf": "^3.1.0",
    "dotenv": "^16.4.1",
    "drizzle-kit": "^0.18.1",
    "drizzle-orm": "^0.29.3",
    "eslint": "^8.57.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "google-auth-library": "^10.5.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "module-alias": "^2.2.3",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.1",
    "otplib": "^12.0.1",
    "pdfkit": "^0.14.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "postgres": "^3.4.3",
    "prettier": "^3.2.4",
    "qrcode": "^1.5.3",
    "rate-limit-redis": "^4.2.0",
    "razorpay": "^2.9.3",
    "redis": "^4.6.12",
    "sharp": "^0.34.5",
    "socket.io": "^4.7.4",
    "stripe": "^14.10.0",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3",
    "zod": "^3.22.4"
  }
}
